# MOCK TEMPLATE: คัดลอกไปไว้นอก repository แล้วแทนค่าจาก environment จริง
LOAD_TEST_TARGET=staging
LOAD_TEST_READ_ONLY=true
LOAD_TEST_DB_ISOLATED=false
ALLOW_NON_GET=false

LOAD_TEST_ALLOWED_HOST=staging-api.example.test
LOAD_TEST_BLOCKED_HOSTS=api.example.test
BASE_URL=https://staging-api.example.test
LOAD_TEST_ACCOUNTS_FILE=/protected/path/project-load-accounts.json
SUMMARY_EXPORT=/protected/path/page-summary.json
COMBINED_REPORT=/protected/path/page-combined.html

# ./run-load-test.sh --env-file ./load-test.env --scenario soft
SCENARIO_SOFT_FLOW=page_example
SCENARIO_SOFT_EXECUTOR=constant-arrival-rate
SCENARIO_SOFT_JOURNEYS_PER_TIME_UNIT=1
SCENARIO_SOFT_JOURNEY_TIME_UNIT=10s
SCENARIO_SOFT_DURATION=20s
SCENARIO_SOFT_PRE_ALLOCATED_VUS=2
SCENARIO_SOFT_MAX_VUS=5
SCENARIO_SOFT_GRACEFUL_STOP=2s
SCENARIO_SOFT_RUN_TIMEOUT_SECONDS=45
SCENARIO_SOFT_BATCH_SIZE=3
SCENARIO_SOFT_BATCH_PER_HOST=3

# ./run-load-test.sh --env-file ./load-test.env --scenario baseline
SCENARIO_BASELINE_FLOW=page_example
SCENARIO_BASELINE_EXECUTOR=constant-arrival-rate
SCENARIO_BASELINE_JOURNEYS_PER_TIME_UNIT=5
SCENARIO_BASELINE_JOURNEY_TIME_UNIT=1s
SCENARIO_BASELINE_DURATION=5m
SCENARIO_BASELINE_PRE_ALLOCATED_VUS=20
SCENARIO_BASELINE_MAX_VUS=50
SCENARIO_BASELINE_GRACEFUL_STOP=5s
SCENARIO_BASELINE_RUN_TIMEOUT_SECONDS=360
SCENARIO_BASELINE_BATCH_SIZE=3
SCENARIO_BASELINE_BATCH_PER_HOST=3

# ./run-load-test.sh --env-file ./load-test.env --scenario ramp
SCENARIO_RAMP_FLOW=page_example
SCENARIO_RAMP_EXECUTOR=ramping-arrival-rate
SCENARIO_RAMP_START_RATE=1
SCENARIO_RAMP_JOURNEY_TIME_UNIT=1s
SCENARIO_RAMP_RAMP_STAGES='[{"target":1,"duration":"1m"},{"target":5,"duration":"2m"},{"target":10,"duration":"2m"},{"target":0,"duration":"30s"}]'
SCENARIO_RAMP_PRE_ALLOCATED_VUS=20
SCENARIO_RAMP_MAX_VUS=100
SCENARIO_RAMP_GRACEFUL_STOP=5s
SCENARIO_RAMP_RUN_TIMEOUT_SECONDS=390
SCENARIO_RAMP_BATCH_SIZE=3
SCENARIO_RAMP_BATCH_PER_HOST=3

# ./run-load-test.sh --env-file ./load-test.env --scenario concurrent
SCENARIO_CONCURRENT_FLOW=page_example
SCENARIO_CONCURRENT_EXECUTOR=per-vu-iterations
SCENARIO_CONCURRENT_VUS=10
SCENARIO_CONCURRENT_ITERATIONS_PER_VU=1
SCENARIO_CONCURRENT_MAX_DURATION=1m
SCENARIO_CONCURRENT_GRACEFUL_STOP=2s
SCENARIO_CONCURRENT_RUN_TIMEOUT_SECONDS=90
SCENARIO_CONCURRENT_BATCH_SIZE=3
SCENARIO_CONCURRENT_BATCH_PER_HOST=3

# ./run-load-test.sh --env-file ./load-test.env --scenario sustained
SCENARIO_SUSTAINED_FLOW=page_example
SCENARIO_SUSTAINED_EXECUTOR=constant-vus
SCENARIO_SUSTAINED_VUS=10
SCENARIO_SUSTAINED_DURATION=5m
SCENARIO_SUSTAINED_THINK_TIME_SECONDS=10
SCENARIO_SUSTAINED_GRACEFUL_STOP=5s
SCENARIO_SUSTAINED_RUN_TIMEOUT_SECONDS=360
SCENARIO_SUSTAINED_BATCH_SIZE=3
SCENARIO_SUSTAINED_BATCH_PER_HOST=3

K6_WEB_DASHBOARD=true
K6_WEB_DASHBOARD_OPEN=false
K6_WEB_DASHBOARD_EXPORT=/protected/path/page-dashboard.html
LOG_FAILED_RESPONSES=false
